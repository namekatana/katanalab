---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/footer/footer.astro'
import SectionCard from '../../components/shared/section-card.astro'
import { blogContent, type BlogPost } from '../../constants/blog'
import { formatDate } from '../../utils/format-date'
import { fade } from 'astro:transitions'

export function getStaticPaths() {
	return blogContent.items.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}))
}

interface Props {
	post: BlogPost
}

const { post } = Astro.props
const titleTransitionName = `blog-title-${post.slug}`
const contentFade = fade({ duration: '0.35s' })
const formattedDate = formatDate(post.date)

function isHeading(block: BlogPost['body'][number]): block is { heading: string } {
	return typeof block === 'object' && 'heading' in block
}

function isList(block: BlogPost['body'][number]): block is { list: string[] } {
	return typeof block === 'object' && 'list' in block
}
---

<Layout title={`${post.title} — katana lab`} description={post.summary}>
	<div class="bg-white px-2 pb-2 pt-2 sm:px-3 sm:pb-3 sm:pt-3 md:px-5 md:pb-5 md:pt-4">
		<div class="mx-auto flex max-w-[90rem] flex-col gap-2 sm:gap-3 md:gap-4">
			<SectionCard>
				<article class="px-4 py-12 sm:px-6 sm:py-16 md:px-10 md:py-24">
					<div class="mx-auto max-w-3xl">
						<a
							href="/blog"
							data-blog-back
							class="text-link mb-8 inline-flex text-sm font-medium lowercase text-neutral-500 sm:mb-10"
							transition:animate={contentFade}
						>
							← all posts
						</a>
						<p
							class="mb-4 text-xs font-medium lowercase tracking-widest text-neutral-400"
							transition:animate={contentFade}
						>
							{formattedDate}
							<span class="mx-2 text-neutral-300">/</span>
							{post.readingTime}
						</p>
						<h1
							data-blog-title
							class="font-display mb-6 text-[1.75rem] font-bold lowercase leading-tight tracking-tight break-words text-neutral-900 sm:text-4xl md:text-5xl"
							style={`view-transition-name: ${titleTransitionName}`}
						>
							{post.title}
						</h1>
						<div transition:animate={contentFade}>
							<p class="mb-10 text-base leading-relaxed text-neutral-500 sm:mb-12 md:text-lg">
								{post.summary}
							</p>
							{post.svg && (
								<div
									class="mb-10 overflow-hidden rounded-xl bg-neutral-50 p-6 sm:mb-12"
									set:html={post.svg}
								/>
							)}
							<div class="flex flex-col gap-6">
								{
									post.body.map((block) => {
										if (isHeading(block)) {
											return (
												<h2 class="mt-4 text-xl font-bold lowercase text-neutral-900 md:text-2xl">
													{block.heading}
												</h2>
											)
										}
										if (isList(block)) {
											return (
												<ul class="flex flex-col gap-2 pl-5 text-base leading-relaxed text-neutral-600 marker:text-neutral-300 md:text-lg [&>li]:list-disc">
													{block.list.map((item) => (
														<li>{item}</li>
													))}
												</ul>
											)
										}
										return (
											<p class="text-base leading-relaxed text-neutral-600 md:text-lg">{block}</p>
										)
									})
								}
							</div>
							<ul class="mt-12 flex flex-wrap gap-x-6 gap-y-2 text-sm lowercase tracking-wide text-neutral-400">
								{post.tags.map((tag) => <li>{tag}</li>)}
							</ul>
						</div>
					</div>
				</article>
			</SectionCard>
			<Footer />
		</div>
	</div>
</Layout>
