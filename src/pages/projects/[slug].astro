---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/footer/footer.astro'
import SectionCard from '../../components/shared/section-card.astro'
import { projectsContent, type ProjectItem } from '../../constants/projects'
import { fade } from 'astro:transitions'

export function getStaticPaths() {
	return projectsContent.items.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}))
}

interface Props {
	project: ProjectItem
}

const { project } = Astro.props
const imageTransitionName = `project-image-${project.slug}`
const contentFade = fade({ duration: '0.35s' })
---

<Layout title={`${project.title} — katana lab`}>
	<div class="bg-white px-3 pb-3 pt-3 md:px-5 md:pb-5 md:pt-4">
		<div class="mx-auto flex max-w-[90rem] flex-col gap-3 md:gap-4">
			<SectionCard>
				<article>
					<div
						data-project-image
						class="aspect-[16/9] overflow-hidden rounded-2xl bg-neutral-100"
						style={`view-transition-name: ${imageTransitionName}`}
					>
						<img
							src={project.image}
							alt={project.imageAlt}
							class="h-full w-full object-cover"
							loading="eager"
							decoding="async"
						/>
					</div>
					<div class="px-6 py-16 md:px-10 md:py-20" transition:animate={contentFade}>
						<div class="mx-auto max-w-7xl">
							<a
								href="/projects"
								data-projects-back
								class="text-link mb-10 inline-flex text-sm font-medium lowercase text-neutral-500"
							>
								← all projects
							</a>
							<p class="mb-4 text-xs font-medium lowercase tracking-widest text-neutral-400">
								{project.category}
								<span class="mx-2 text-neutral-300">/</span>
								{project.year}
							</p>
							<h1 class="font-display mb-6 max-w-3xl text-4xl font-bold lowercase leading-tight tracking-tight text-neutral-900 md:text-5xl">
								{project.title}
							</h1>
							<p class="mb-10 max-w-2xl text-base leading-relaxed text-neutral-500 md:text-lg">
								{project.summary}
							</p>
							<ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm lowercase tracking-wide text-neutral-400">
								{
									project.tags.map((tag) => (
										<li>{tag}</li>
									))
								}
							</ul>
						</div>
					</div>
				</article>
			</SectionCard>
			<Footer />
		</div>
	</div>
</Layout>
