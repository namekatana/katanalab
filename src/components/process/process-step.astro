---
import type { ProcessStep } from '../../constants/process'

interface Props {
	step: ProcessStep
}

const { step } = Astro.props
---

<article
	data-process-step
	class="relative flex h-full min-w-0 flex-col items-start rounded-2xl border border-neutral-200 bg-white p-5 sm:p-6 md:p-7"
>
	<span
		class="relative z-10 mb-5 size-3 rounded-full bg-neutral-900"
		aria-hidden="true"
	></span>
	<span class="font-display mb-4 block text-5xl font-bold text-neutral-200">
		{step.number}
	</span>
	<h3 class="mb-3 text-xl font-bold lowercase text-neutral-900">
		{step.title}
	</h3>
	<p class="mb-5 max-w-xs text-sm leading-relaxed text-neutral-500">
		{step.description}
	</p>
	<p class="mt-auto max-w-xs rounded-xl bg-neutral-50 px-3 py-2.5 text-sm font-medium lowercase leading-snug text-neutral-900">
		{step.outcome}
	</p>
</article>
