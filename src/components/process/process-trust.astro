---
import { processContent } from '../../constants/process'
---

<ul
	data-process-trust
	class="mt-10 grid grid-cols-1 gap-3 md:mt-12 md:grid-cols-3 md:gap-4"
>
	{
		processContent.trustPoints.map((point) => (
			<li class="flex items-start gap-3 rounded-2xl bg-neutral-900 px-5 py-4 text-sm font-medium lowercase leading-snug text-white md:text-base">
				<span
					class="mt-1.5 size-2 shrink-0 rounded-full bg-white"
					aria-hidden="true"
				/>
				<span>{point}</span>
			</li>
		))
	}
</ul>
