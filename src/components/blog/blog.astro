---
import { blogContent } from '../../constants/blog'
import SectionHeader from '../shared/section-header.astro'
import BlogCard from './blog-card.astro'
---

<section
	data-blog
	class="py-20 md:py-28"
	aria-label="blog"
>
	<div class="mx-auto max-w-7xl px-6 md:px-10">
		<SectionHeader
			eyebrow={blogContent.eyebrow}
			heading={blogContent.heading}
			subheading={blogContent.subheading}
			headingClass="max-w-2xl"
		/>
		<div class="mt-16 grid grid-cols-1 items-stretch gap-8 md:mt-20 md:grid-cols-3">
			{blogContent.items.map((post) => <BlogCard post={post} />)}
		</div>
	</div>
</section>

<script>
	import { initBlogAnimation } from '../../scripts/blog-animation'

	document.addEventListener('astro:page-load', () => {
		const blog = document.querySelector<HTMLElement>('[data-blog]')
		if (blog) initBlogAnimation(blog)
	})
</script>