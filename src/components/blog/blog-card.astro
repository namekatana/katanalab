---
import type { BlogPost } from '../../constants/blog'
import { formatDate } from '../../utils/format-date'

interface Props {
	post: BlogPost
}

const { post } = Astro.props
const titleTransitionName = `blog-title-${post.slug}`
const formattedDate = formatDate(post.date)
---

<a
	href={post.href}
	data-blog-card
	class="group flex h-full flex-col rounded-2xl p-6 transition-all duration-300 ease-out hover:bg-neutral-50 md:p-8"
>
	<span
		class="mb-6 block h-[3px] w-10 rounded-full bg-neutral-200 transition-colors duration-300 group-hover:bg-neutral-900"
		aria-hidden="true"
	></span>

	<p class="mb-3 text-xs font-medium lowercase tracking-widest text-neutral-400">
		{formattedDate}
		<span class="mx-2 text-neutral-300">/</span>
		{post.readingTime}
	</p>

	<div class="mb-4 flex items-start gap-2">
		<h2
			data-blog-title
			class="text-2xl font-bold lowercase text-neutral-900"
			style={`view-transition-name: ${titleTransitionName}`}
		>
			{post.title}
		</h2>
		<span
			class="mt-1 inline-block opacity-0 transition-all duration-300 ease-out group-hover:translate-x-1 group-hover:opacity-100"
			aria-hidden="true"
		>
			→
		</span>
	</div>

	<p class="mb-8 max-w-sm flex-1 text-base leading-relaxed text-neutral-500">
		{post.summary}
	</p>

	<span class="text-link mt-auto inline-flex w-fit text-sm font-medium lowercase text-neutral-900">
		read article →
	</span>
</a>
