---
import FooterBrand from './footer-brand.astro'
import FooterLinks from './footer-links.astro'
import FooterBottom from './footer-bottom.astro'
---

<footer
	data-footer
	class="rounded-2xl bg-neutral-900 px-4 py-6 text-white sm:rounded-3xl sm:px-6 sm:py-12 md:px-10 md:py-16"
	aria-label="footer"
>
	<div class="mx-auto flex max-w-7xl flex-col gap-6 sm:gap-12 md:gap-16">
		<div class="flex flex-col gap-6 sm:gap-12 lg:flex-row lg:items-start lg:justify-between lg:gap-20">
			<FooterBrand />
			<FooterLinks />
		</div>
		<FooterBottom />
	</div>
</footer>
