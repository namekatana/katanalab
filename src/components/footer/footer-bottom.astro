---
import { footerContent } from '../../constants/footer'
---

<div class="flex flex-col gap-2 border-t border-white/10 pt-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:pt-8">
	<p class="text-[0.625rem] lowercase tracking-wide text-neutral-500 sm:text-xs md:text-sm">
		{footerContent.legal}
	</p>
	<a
		href={`mailto:${footerContent.email}`}
		class="break-all text-xs lowercase text-neutral-400 transition-colors duration-300 hover:text-white sm:text-sm"
	>
		{footerContent.email}
	</a>
</div>
