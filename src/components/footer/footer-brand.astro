---
import { footerContent } from '../../constants/footer'
---

<div class="flex flex-col gap-4 sm:gap-8 md:max-w-sm">
	<a href="/" class="inline-flex w-fit" aria-label="katana lab home">
		<img
			src="/images/logo.png"
			alt="katana lab"
			width="140"
			height="40"
			class="h-7 w-auto brightness-0 invert sm:h-8 md:h-9"
		/>
	</a>
	<p class="text-xs leading-snug text-neutral-400 sm:text-sm sm:leading-relaxed md:text-base">
		{footerContent.tagline}
	</p>
	<a
		href={footerContent.cta.href}
		class="inline-flex w-fit items-center justify-center rounded-full bg-white px-5 py-2.5 text-xs font-medium lowercase tracking-wide text-neutral-900 transition-transform duration-300 ease-out hover:scale-105 sm:px-6 sm:py-3 sm:text-sm"
	>
		{footerContent.cta.label}
	</a>
</div>
