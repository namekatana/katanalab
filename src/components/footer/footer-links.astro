---
import { footerContent } from '../../constants/footer'
---

<div class="grid grid-cols-3 gap-3 sm:gap-8 md:gap-10">
	{
		footerContent.columns.map((column) => (
			<div class="flex min-w-0 flex-col gap-2 sm:gap-4">
				<p class="text-[0.625rem] font-medium lowercase tracking-widest text-neutral-500 sm:text-xs">
					{column.title}
				</p>
				<ul class="flex flex-col gap-1.5 sm:gap-3">
					{column.links.map((link) => (
						<li>
							<a
								href={link.href}
								class="break-words text-xs lowercase leading-snug text-neutral-300 transition-colors duration-300 hover:text-white sm:text-sm"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		))
	}
</div>
