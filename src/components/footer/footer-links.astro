---
import { footerContent } from '../../constants/footer'
---

<div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:gap-10">
	{
		footerContent.columns.map((column) => (
			<div class="flex flex-col gap-4">
				<p class="text-xs font-medium lowercase tracking-widest text-neutral-500">
					{column.title}
				</p>
				<ul class="flex flex-col gap-3">
					{column.links.map((link) => (
						<li>
							<a
								href={link.href}
								class="text-sm lowercase text-neutral-300 transition-colors duration-300 hover:text-white"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		))
	}
</div>
