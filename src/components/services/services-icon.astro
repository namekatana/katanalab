---
import type { ServiceIcon } from '../../constants/services'

interface Props {
	name: ServiceIcon
	class?: string
}

const { name, class: className = '' } = Astro.props
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width="28"
	height="28"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	{
		name === 'code' && (
			<>
				<polyline points="16 18 22 12 16 6" />
				<polyline points="8 6 2 12 8 18" />
			</>
		)
	}
	{
		name === 'chat' && (
			<>
				<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
			</>
		)
	}
	{
		name === 'phone' && (
			<>
				<rect width="14" height="20" x="5" y="2" rx="2" ry="2" />
				<path d="M12 18h.01" />
			</>
		)
	}
</svg>
