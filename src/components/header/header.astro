---
import HeaderLogo from './header-logo.astro'
import HeaderNav from './header-nav.astro'
import HeaderCta from './header-cta.astro'
import HeaderToggle from './header-toggle.astro'
import HeaderMobileMenu from './header-mobile-menu.astro'
---

<div transition:persist="site-header" class="relative z-50">
	<header
		id="site-header"
		class="sticky top-0 z-50 w-full border-b border-transparent bg-white/95 backdrop-blur-md supports-[backdrop-filter]:bg-white/90"
	>
		<div class="mx-auto grid max-w-7xl grid-cols-[1fr_auto] items-center px-4 py-4 sm:px-6 sm:py-6 md:grid-cols-[1fr_auto_1fr] md:px-10 md:py-8">
			<HeaderLogo class="justify-self-start" />
			<HeaderNav class="justify-self-center" />
			<div class="flex items-center justify-end gap-3 justify-self-end sm:gap-4">
				<HeaderCta />
				<HeaderToggle />
			</div>
		</div>
	</header>

	<HeaderMobileMenu />
</div>

<script>
	import { initHeaderMenu } from '../../scripts/header-menu'

	initHeaderMenu()
</script>
