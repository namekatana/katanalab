---
import HeaderLogo from './header-logo.astro'
import HeaderNav from './header-nav.astro'
import HeaderCta from './header-cta.astro'
import HeaderToggle from './header-toggle.astro'
import HeaderMobileMenu from './header-mobile-menu.astro'
---

<header
	id="site-header"
	class="w-full bg-white"
>
	<div class="mx-auto grid max-w-7xl grid-cols-[1fr_auto] items-center px-6 py-6 md:grid-cols-[1fr_auto_1fr] md:px-10 md:py-8">
		<HeaderLogo class="justify-self-start" />
		<HeaderNav class="justify-self-center" />
		<div class="flex items-center justify-end gap-4 justify-self-end">
			<HeaderCta />
			<HeaderToggle />
		</div>
	</div>
</header>

<HeaderMobileMenu />

<script>
	import { initHeaderMenu } from '../../scripts/header-menu'

	initHeaderMenu()
</script>
