---
import { ctaLink, navLinks } from '../../constants/navigation'
---

<div
	id="header-mobile-menu"
	class="mobile-menu pointer-events-none fixed inset-0 z-40 flex flex-col bg-white opacity-0 md:hidden"
	aria-hidden="true"
>
	<div
		class="flex flex-1 flex-col items-center justify-center gap-2 overflow-y-auto overscroll-contain px-6 pb-[max(2rem,env(safe-area-inset-bottom))] pt-[max(5.5rem,calc(env(safe-area-inset-top)+4.5rem))]"
	>
		<p class="mb-6 text-xs font-medium lowercase tracking-widest text-neutral-400">
			menu
		</p>
		{
			navLinks.map((link, index) => (
				<a
					href={link.href}
					class="mobile-link font-display w-full max-w-xs py-3 text-center text-3xl font-bold lowercase tracking-tight text-neutral-900 transition-colors duration-300 hover:text-neutral-500"
					style={`--delay: ${index * 60}ms`}
				>
					{link.label}
				</a>
			))
		}
		<a
			href={ctaLink.href}
			data-cta-button
			class="cta-button mobile-link hero-gpu mt-8 inline-flex w-full max-w-xs items-center justify-center rounded-full bg-neutral-900 px-8 py-3.5 text-sm font-medium lowercase tracking-wide text-white"
			style={`--delay: ${navLinks.length * 60}ms`}
		>
			{ctaLink.label}
		</a>
	</div>
</div>
