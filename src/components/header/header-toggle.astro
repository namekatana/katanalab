---
interface Props {
	class?: string
}

const { class: className = '' } = Astro.props
---

<button
	type="button"
	id="header-toggle"
	class:list={[
		'relative z-50 flex h-11 w-11 items-center justify-center md:hidden',
		className,
	]}
	aria-label="open menu"
	aria-expanded="false"
	aria-controls="header-mobile-menu"
>
	<span class="sr-only">menu</span>
	<span class="hamburger flex h-4 w-5 flex-col justify-between" aria-hidden="true">
		<span class="hamburger-line block h-0.5 w-full origin-center bg-neutral-900 transition duration-300"></span>
		<span class="hamburger-line block h-0.5 w-full origin-center bg-neutral-900 transition duration-300"></span>
		<span class="hamburger-line block h-0.5 w-full origin-center bg-neutral-900 transition duration-300"></span>
	</span>
</button>
