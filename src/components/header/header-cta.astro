---
import { ctaLink } from '../../constants/navigation'

interface Props {
	class?: string
}

const { class: className = '' } = Astro.props
---

<a
	href={ctaLink.href}
	data-cta-button
	class:list={[
		'hidden md:inline-flex items-center justify-center rounded-full bg-neutral-900 px-6 py-2.5 text-sm font-medium lowercase tracking-wide text-white',
		className,
	]}
>
	{ctaLink.label}
</a>
