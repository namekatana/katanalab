---
interface Props {
	eyebrow: string
	heading: string
	subheading?: string
	headingClass?: string
}

const {
	eyebrow,
	heading,
	subheading,
	headingClass = 'max-w-3xl',
} = Astro.props
---

<div class="flex flex-col items-start">
	<p class="mb-4 text-xs font-medium lowercase tracking-widest text-neutral-400 md:text-sm">
		{eyebrow}
	</p>
	<h2
		class:list={[
			'font-display text-4xl font-bold lowercase leading-tight tracking-tight text-neutral-900 md:text-5xl',
			headingClass,
		]}
	>
		{heading}
	</h2>
	{
		subheading && (
			<p class="mt-6 max-w-2xl text-base leading-relaxed text-neutral-500 md:text-lg">
				{subheading}
			</p>
		)
	}
</div>
