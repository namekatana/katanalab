---
import FaqHeader from './faq-header.astro'
import FaqList from './faq-list.astro'
---

<section
	data-faq
	class="py-14 sm:py-20 md:py-28"
	aria-label="frequently asked questions"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 md:px-10">
		<FaqHeader />
		<FaqList />
	</div>
</section>

<script>
	import { initFaq } from '../../scripts/faq-accordion'
	import { initFaqAnimation } from '../../scripts/faq-animation'

	document.addEventListener('astro:page-load', () => {
		const faq = document.querySelector<HTMLElement>('[data-faq]')
		if (!faq) return
		initFaq(faq)
		initFaqAnimation(faq)
	})
</script>
