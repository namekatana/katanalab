---
import { heroContent } from '../../constants/hero'

const headline = heroContent.headlineLines.join(' ')
---

<h1
	data-hero-headline
	class="font-display flex max-w-4xl flex-col gap-2 text-4xl font-bold leading-[1.1] tracking-tight text-neutral-900 md:gap-3 md:text-6xl lg:text-7xl xl:text-8xl"
	aria-label={headline}
>
	{
		heroContent.headlineLines.map((line) => (
			<span data-hero-line class="block">
				{line}
			</span>
		))
	}
</h1>
