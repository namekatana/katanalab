---
import type { PricingItem } from '../../constants/pricing'
import PricingIcon from './pricing-icon.astro'

interface Props {
	item: PricingItem
}

const { item } = Astro.props
const featured = Boolean(item.featured)
---

<article
	data-pricing-card
	class:list={[
		'relative flex h-full flex-col pt-8',
		featured
			? 'rounded-2xl bg-neutral-900 px-5 pb-8 pt-10 text-white shadow-[0_20px_40px_-24px_rgba(0,0,0,0.45)] sm:px-6 lg:scale-105'
			: 'border-t border-neutral-200',
	]}
>
	{
		featured && (
			<span class="absolute -top-3 left-6 inline-flex rounded-full bg-white px-3 py-1 text-xs font-medium lowercase tracking-wide text-neutral-900">
				most popular
			</span>
		)
	}

	<div class:list={['mb-5', featured ? 'text-white' : 'text-neutral-900']}>
		<PricingIcon name={item.icon} />
	</div>

	<h3
		class:list={[
			'mb-6 text-xl font-bold lowercase',
			featured ? 'text-white' : 'text-neutral-900',
		]}
	>
		{item.title}
	</h3>

	<div class="mb-4">
		<span class="mb-1 block text-sm lowercase text-neutral-400">from</span>
		<p
			class:list={[
				'font-display text-4xl font-bold',
				featured ? 'text-white' : 'text-neutral-900',
			]}
		>
			{item.priceUsd}
		</p>
		<p class="mt-1 text-sm text-neutral-400">
			{item.priceUah}
		</p>
	</div>

	<p
		class:list={[
			'mb-6 text-sm leading-relaxed',
			featured ? 'text-neutral-300' : 'text-neutral-500',
		]}
	>
		{item.description}
	</p>

	<ul class="mb-8 flex flex-1 flex-col gap-2.5">
		{
			item.features.map((feature) => (
				<li
					class:list={[
						'flex items-start gap-2 text-sm lowercase leading-snug',
						featured ? 'text-neutral-300' : 'text-neutral-600',
					]}
				>
					<span
						class:list={[
							'mt-0.5 shrink-0',
							featured ? 'text-white' : 'text-neutral-900',
						]}
						aria-hidden="true"
					>
						✓
					</span>
					<span>{feature}</span>
				</li>
			))
		}
	</ul>

	<a
		href={item.href}
		class:list={[
			'text-link mt-auto inline-flex w-fit text-sm font-medium lowercase',
			featured ? 'text-white' : 'text-neutral-900',
		]}
	>
		get a quote →
	</a>
</article>
