---
import { projectsContent } from '../../constants/projects'
import SectionHeader from '../shared/section-header.astro'
import ProjectCard from './project-card.astro'
---

<section
	data-projects
	class="py-14 sm:py-20 md:py-28"
	aria-label="projects"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 md:px-10">
		<SectionHeader
			eyebrow={projectsContent.eyebrow}
			heading={projectsContent.heading}
			subheading={projectsContent.subheading}
			headingClass="max-w-2xl"
		/>
		<div class="mt-16 grid grid-cols-1 items-stretch gap-8 md:mt-20 md:grid-cols-3">
			{projectsContent.items.map((project) => <ProjectCard project={project} />)}
		</div>
	</div>
</section>
