<div
	id="site-scrollbar"
	class="site-scrollbar"
	data-scrollbar
	data-visible="false"
	aria-hidden="true"
>
	<div data-scrollbar-track class="site-scrollbar-track">
		<button
			type="button"
			data-scrollbar-thumb
			class="site-scrollbar-thumb"
			tabindex="-1"
			aria-label="scroll"
		></button>
	</div>
</div>

<script>
	import 'lenis/dist/lenis.css'
	import { initSmoothScroll } from '../../scripts/smooth-scroll'
	import { initCustomScrollbar } from '../../scripts/custom-scrollbar'

	initSmoothScroll()

	const scrollbar = document.querySelector<HTMLElement>('[data-scrollbar]')

	if (scrollbar) {
		initCustomScrollbar(scrollbar)
	}
</script>
